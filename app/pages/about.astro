---
import { Picture } from "astro:assets";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { aboutNavigation, contact, equipmentNavigation, individualProjectNavigation, sparePartsNavigation } from "../content/site";
import field from "../assets/about/harvesting-in-field.jpg";
import welding from "../assets/individual-project-manufacturing.jpg";
import cutting from "../assets/about/metal-cutting.jpg";
import machining from "../assets/about/machining.jpg";

const breadcrumbs = [{ label: "Главная", href: "/" }, aboutNavigation];
// Historical dates are from «Перая версия/xn--b1altk.xn--p1ai_about_ (2).png».
const milestones = [
  { year: "2007", title: "Начали с работы с хозяйствами", text: "Начали поставлять сельскохозяйственную технику и запасные части, заниматься сервисом под именем АГРОС. С этого началась наша история." },
  { year: "2011", title: "Создали своё конструкторское бюро", text: "От подбора готовой техники перешли к разработке собственных машин." },
  { year: "2012", title: "Выпустили первый НОУТ-6", text: "Навесной овощеуборочный транспортёр представили на выставке «Золотая осень» в Москве." },
  { year: "2013", title: "Разработали НОУТ-3", text: "Добавили облегчённую модель овощеуборочного транспортёра с установкой на прицеп или навеску трактора." },
  { year: "2016", title: "Объединили технику под именем ИСВО", text: "В этом же году разработали культиватор для междурядий и модульную линию предпродажной подготовки капусты." },
];
const workshop = [
  { image: welding, alt: "Сварщик собирает металлическую раму оборудования ИСВО в цехе", title: "Сварка и сборка", text: "Из отдельных деталей складывается конструкция машины." },
  { image: cutting, alt: "Раскрой металлического листа на станке в производственном цехе", title: "Раскрой металла", text: "Детали будущего оборудования начинаются с заготовок." },
  { image: machining, alt: "Токарный станок с числовым программным управлением в цехе", title: "Обработка деталей", text: "Посадочные места, валы и другие элементы рабочих узлов." },
];
const nextSteps = [
  { href: equipmentNavigation.href, title: "Серийная техника", text: "Посев, уход, уборка и переработка овощей" },
  { href: individualProjectNavigation.href, title: individualProjectNavigation.label, text: "Разработка под вашу технологию и условия" },
  { href: sparePartsNavigation.href, title: sparePartsNavigation.label, text: "Всё, что нужно для дальнейшей работы" },
];
const fieldSizes = "(max-width: 767px) calc(100vw - 48px), (max-width: 1199px) calc(100vw - 64px), (max-width: 1768px) calc(100vw - 268px - 8.3vw), 1340px";
const workshopSizes = "(max-width: 599px) calc(100vw - 48px), (max-width: 767px) calc((100vw - 64px) / 2), (max-width: 1199px) calc((100vw - 112px) / 3), (max-width: 1768px) calc((100vw - 268px - 8.3vw - 48px) / 3), 431px";
const workshopLeadSizes = "(max-width: 767px) calc(100vw - 48px), " + workshopSizes;
---
<SiteLayout title="О компании — разработка и производство техники для овощеводства | ИСВО" description="История ИСВО: от поставок сельхозтехники в 2007 году к собственному КБ и производству. Фотографии цеха и техники в работе, этапы развития компании." pageType="AboutPage" breadcrumbs={breadcrumbs}>
  <article class="about-page" aria-labelledby="about-title">
    <header class="about-hero about-container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="about-hero__heading">
        <div>
          <p class="eyebrow">О компании · ИСВО</p>
          <h1 id="about-title">От чертежа<br />до работы в поле<span>.</span></h1>
        </div>
        <div class="about-hero__intro">
          <p>Мы разрабатываем и производим технику для овощеводства. Для вполне конкретных дел: посеять, убрать сорняки, собрать урожай, подготовить овощи к хранению и продаже.</p>
          <p>За машинами ИСВО — своё конструкторское бюро, производственный цех и опыт работы с хозяйствами с&nbsp;2007&nbsp;года.</p>
          <a class="text-link" href="#production">Посмотреть производство<ArrowDown size={17} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
        </div>
      </div>
      <figure class="about-field">
        <div class="about-field__image">
          <Picture src={field} alt="Платформа ПВУ-18 с бригадой на уборке капусты: транспортёры раскрыты поперёк рядов" width={1440} widths={[400, 640, 960, 1440, 1920, 2400]} sizes={fieldSizes} formats={["avif"]} fallbackFormat="webp" quality={50} loading="eager" fetchpriority="high" />
          <div class="about-field__label" aria-hidden="true"><span>Разрабатываем.<br />Производим.</span><strong>ИСВО</strong></div>
        </div>
        <figcaption><span>ПВУ-18 на уборке капусты</span><span>Из цеха — в рабочий день хозяйства</span></figcaption>
      </figure>
    </header>

    <section id="production" class="about-production about-container" aria-labelledby="production-title">
      <div class="about-section-heading">
        <div><p class="eyebrow">Собственная разработка и производство</p><h2 id="production-title">Свои чертежи.<br />Свой цех.</h2></div>
        <div class="about-section-copy">
          <p>Ширина междурядий, культура, способ уборки, трактор в хозяйстве — всё это влияет на конструкцию. Поэтому работа над машиной начинается с вопросов о том, как её будут использовать.</p>
          <p>Дальше — чертежи, металл, обработка деталей и сборка. Серийные модели решают повторяющиеся задачи. Для особых условий мы разрабатываем <a href={individualProjectNavigation.href}>индивидуальные проекты</a>.</p>
        </div>
      </div>
      <div class="about-workshop">
        {workshop.map((photo, index) => (
          <figure>
            <div class="about-workshop__image"><Picture src={photo.image} alt={photo.alt} width={640} widths={[320, 480, 640, 960, 1280]} sizes={index === 0 ? workshopLeadSizes : workshopSizes} formats={["avif"]} fallbackFormat="webp" quality={65} loading="lazy" /></div>
            <figcaption><span class="about-workshop__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><h3>{photo.title}</h3><p>{photo.text}</p></div></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="about-history" aria-labelledby="history-title">
      <div class="about-container about-history__grid">
        <div class="about-history__heading"><p class="eyebrow">Наша история</p><h2 id="history-title">От поставок техники<br />к своим машинам</h2><p>Сначала мы помогали хозяйствам подбирать оборудование. Затем начали создавать своё.</p></div>
        <ol class="about-timeline" role="list">
          {milestones.map(milestone => <li><span class="about-timeline__year">{milestone.year}</span><div><h3>{milestone.title}</h3><p>{milestone.text}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="about-next about-container" aria-labelledby="next-title">
      <div class="about-next__copy">
        <p class="eyebrow">Продолжим предметно</p>
        <h2 id="next-title">Что нужно сделать<br />в вашем хозяйстве?</h2>
        <p>Расскажите о культуре, условиях и рабочей операции. Посмотрим, какая машина подойдёт, что потребуется изменить или разработать с нуля.</p>
        <a class="button button-primary" href={contact.emailHref} data-inquiry="about">Обсудить задачу<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
      </div>
      <nav class="about-next__links" aria-label="Техника и услуги ИСВО"><ul role="list">
        {nextSteps.map(item => <li><a href={item.href}><span><strong>{item.title}</strong><span>{item.text}</span></span><ArrowRight size={22} stroke-width={1.5} aria-hidden="true" focusable="false" /></a></li>)}
      </ul></nav>
    </section>
  </article>
</SiteLayout>

<style>
  .about-container { max-width: 1500px; margin-inline: auto; padding-inline: var(--page-gutter); }
  .about-hero { padding-top: 40px; padding-bottom: clamp(48px, 6vw, 88px); }
  .eyebrow { margin: 0 0 20px; color: var(--color-green); font-size: var(--font-size-caption); font-weight: 700; line-height: 1.6; letter-spacing: .1em; text-transform: uppercase; }
  .about-hero__heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; gap: 40px; margin-bottom: 40px; }
  h1 { max-width: 13ch; margin: 0; font-size: clamp(2.75rem, 4.5vw, 4.75rem); font-weight: 700; line-height: 1.08; letter-spacing: -.045em; word-spacing: .04em; }
  h1 > span { color: var(--color-green); }
  .about-hero__intro { padding-bottom: 2px; }
  .about-hero__intro p { max-width: 49ch; margin: 0 0 16px; color: var(--color-muted); }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--color-green); font-size: var(--font-size-control); font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .text-link svg { flex: none; }
  figure { min-width: 0; margin: 0; }
  .about-field__image { position: relative; overflow: hidden; aspect-ratio: 2.45; border-radius: var(--radius-leaf-card); background: var(--color-line); }
  .about-field__image :global(picture), .about-workshop__image :global(picture) { display: block; width: 100%; height: 100%; }
  .about-field__image :global(img), .about-workshop__image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .about-field__image :global(img) { object-position: center 58%; }
  .about-field__label { position: absolute; inset: auto auto 24px 24px; display: flex; flex-direction: column; gap: 20px; padding: 20px 24px; color: var(--color-white); background: var(--color-green); border-radius: var(--radius-leaf-control); }
  .about-field__label > span { font-size: var(--font-size-small); line-height: 1.6; }
  .about-field__label strong { color: var(--color-yellow); font-size: 1.5rem; line-height: 1; font-weight: 700; letter-spacing: -.04em; }
  .about-field > figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; padding-top: 16px; color: var(--color-muted); font-size: var(--font-size-caption); }
  h2 { margin: 0; font-size: var(--font-size-section); font-weight: 700; line-height: 1.13; letter-spacing: -.045em; text-wrap: balance; }
  .about-production { padding-bottom: clamp(56px, 7vw, 104px); scroll-margin-top: 32px; }
  .about-section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; gap: 40px; padding-top: 40px; border-top: 1px solid var(--color-line); }
  .about-section-copy p { max-width: 56ch; margin: 0 0 16px; color: var(--color-muted); }
  .about-section-copy p:last-child { margin-bottom: 0; }
  .about-section-copy a { color: var(--color-green); text-decoration: underline; text-underline-offset: 4px; }
  .about-workshop { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 40px; }
  .about-workshop__image { overflow: hidden; aspect-ratio: 4 / 3; border-radius: var(--radius-leaf-control); background: var(--color-line); }
  .about-workshop figcaption { display: flex; align-items: baseline; gap: 12px; padding-top: 20px; }
  .about-workshop__number { flex: none; color: var(--color-green); font-size: var(--font-size-caption); font-weight: 700; }
  .about-workshop h3 { margin: 0; font-size: 1.125rem; font-weight: 700; line-height: 1.4; letter-spacing: -.025em; }
  .about-workshop p { margin: 8px 0 0; color: var(--color-muted); font-size: var(--font-size-control); line-height: 1.75; }
  .about-history { padding-block: clamp(48px, 6vw, 88px); color: var(--color-white); background: var(--color-green); }
  .about-history__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 80px); }
  .about-history .eyebrow { color: var(--color-yellow); }
  .about-history h2 { font-size: clamp(2rem, 2.8vw, 2.75rem); }
  .about-history__heading > p:last-child { max-width: 34ch; margin: 24px 0 0; color: rgb(255 255 255 / .85); }
  .about-timeline { list-style: none; margin: 0; padding: 0; }
  .about-timeline li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 24px; padding-block: 24px; border-top: 1px solid rgb(255 255 255 / .3); }
  .about-timeline li:first-child { padding-top: 0; border-top: 0; }
  .about-timeline li:last-child { padding-bottom: 0; }
  .about-timeline__year { color: var(--color-yellow); font-size: 1.5rem; font-weight: 700; line-height: 1.35; letter-spacing: -.04em; }
  .about-timeline h3 { margin: 0; font-size: 1.125rem; font-weight: 700; line-height: 1.5; letter-spacing: -.02em; }
  .about-timeline p { margin: 8px 0 0; color: rgb(255 255 255 / .85); font-size: var(--font-size-control); line-height: 1.8; }
  .about-next { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(32px, 5vw, 80px); padding-block: clamp(48px, 6vw, 88px); }
  .about-next h2 { font-size: clamp(1.875rem, 2.8vw, 2.75rem); }
  .about-next__copy > p:not(.eyebrow) { max-width: 45ch; margin: 24px 0 28px; color: var(--color-muted); }
  .about-next__links ul { list-style: none; margin: 0; padding: 0; }
  .about-next__links li { border-top: 1px solid var(--color-line); }
  .about-next__links li:last-child { border-bottom: 1px solid var(--color-line); }
  .about-next__links a { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 0; text-decoration: none; }
  .about-next__links strong { display: block; font-size: 1.125rem; font-weight: 700; line-height: 1.4; letter-spacing: -.025em; }
  .about-next__links span > span { display: block; margin-top: 8px; color: var(--color-muted); font-size: var(--font-size-control); }
  .about-next__links svg { flex: none; color: var(--color-green); }
  @media (hover: hover) { .about-next__links a:hover strong { color: var(--color-green); text-decoration: underline; text-underline-offset: 5px; } }
  @media (min-width: 768px) and (max-width: 1199px) {
    .about-hero__heading { gap: 32px; }
    .about-hero__intro { font-size: 1rem; }
    .about-history__grid { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
    .about-timeline li { gap: 16px; }
  }
  @media (max-width: 767px) {
    .about-hero { padding-top: 24px; }
    .about-hero__heading, .about-section-heading, .about-history__grid, .about-next { grid-template-columns: 1fr; gap: 28px; }
    .about-hero__heading { margin-bottom: 28px; }
    h1 { font-size: clamp(2.5rem, 8vw, 3.75rem); }
    .about-hero__intro p { max-width: 59ch; }
    .eyebrow { margin-bottom: 16px; }
    .about-field__image { aspect-ratio: 4 / 3; }
    .about-field__image :global(img) { object-position: 52% center; }
    .about-field__label { inset: auto auto 16px 16px; gap: 0; padding: 12px 16px; }
    .about-field__label > span { display: none; }
    .about-field__label strong { font-size: 1.125rem; }
    .about-field > figcaption { gap: 4px 24px; padding-top: 12px; }
    .about-section-heading { padding-top: 32px; }
    .about-workshop { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; margin-top: 32px; }
    .about-workshop figure:first-child { grid-column: 1 / -1; }
    .about-workshop figure:first-child .about-workshop__image { aspect-ratio: 16 / 9; }
    .about-workshop figure:first-child :global(img) { object-position: center 42%; }
    .about-workshop figcaption { gap: 10px; padding-top: 16px; }
    .about-history__heading > p:last-child { max-width: 53ch; }
    .about-history__grid { gap: 40px; }
    .about-timeline li { grid-template-columns: 56px minmax(0, 1fr); gap: 20px; }
    .about-timeline__year { font-size: 1.375rem; }
    .about-next { gap: 40px; }
  }
  @media (max-width: 599px) {
    .about-workshop { grid-template-columns: 1fr; gap: 32px; }
    .about-workshop figure:first-child .about-workshop__image, .about-workshop__image { aspect-ratio: 4 / 3; }
    .about-field > figcaption span { flex-basis: 100%; }
  }
</style>
