---
import { Picture } from "astro:assets";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Check from "@lucide/astro/icons/check";
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { contact, usedEquipmentNavigation } from "../content/site";
import equipmentSide from "../assets/used-equipment/equipment-side.jpg";
import equipmentFront from "../assets/used-equipment/equipment-front.jpg";

const breadcrumbs = [
  { label: "Главная", href: "/" },
  usedEquipmentNavigation,
];
const tradeInSteps = [
  { title: "Расскажите о вашей технике", text: "Пришлите описание и фотографии техники или оборудования, которое хотите передать в зачёт нового." },
  { title: "Согласуем оценку", text: "Рассмотрим предложение, уточним состояние и обсудим стоимость зачёта и условия обмена." },
  { title: "Выберем новую технику", text: "Подберём оборудование под задачи хозяйства и согласуем доплату с учётом стоимости вашей техники." },
];
const offerDetails = [
  "Марка, модель и год выпуска, если известны.",
  "Состояние, комплектность и необходимые ремонтные работы.",
  "Фотографии общего вида и основных узлов, местонахождение техники.",
  "Для Trade-in — какая новая техника вас интересует.",
];
---
<SiteLayout title="Техника Б/У — выкуп, восстановление и Trade-in | ИСВО" description="Выкупаем сельскохозяйственную технику и оборудование Б/У, восстанавливаем и продаём. Предложите свою технику на выкуп или в зачёт новой по программе Trade-in." breadcrumbs={breadcrumbs}>
  <article class="used-page" aria-labelledby="used-equipment-title">
    <header class="used-hero used-container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="used-hero__grid">
        <div class="used-hero__copy">
          <p class="eyebrow">Выкуп · Восстановление · Продажа</p>
          <h1 id="used-equipment-title">{usedEquipmentNavigation.label}</h1>
          <p class="used-hero__lead">Возвращаем технику<br />в работу</p>
          <p class="used-hero__description">Выкупаем бывшую в эксплуатации сельскохозяйственную технику и оборудование, восстанавливаем их и предлагаем к продаже.</p>
          <p class="used-hero__description">Хотите обновить парк? Предложите свою технику на выкуп или в зачёт новой по программе <a href="#trade-in">Trade-in</a>.</p>
          <div class="used-hero__actions">
            <a class="button button-primary" href="#offer-equipment">Предложить технику<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
            <a class="used-text-link" href={contact.usedEquipmentAvailabilityEmailHref}>Узнать о наличии<ArrowRight size={18} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
          </div>
        </div>
        <div class="used-photos" role="group" aria-label="Фотографии техники Б/У">
          <Picture src={equipmentSide} alt="Техника Б/У со сложенными транспортёрами на хранении, вид сбоку" width={480} widths={[240, 360, 480, 720]} sizes="(max-width: 767px) calc((min(100vw, 560px) - 64px) / 2), (max-width: 1199px) calc((100vw - 120px) / 4), (max-width: 1768px) calc((100vw - 448px) / 4), 330px" formats={["avif"]} fallbackFormat="webp" quality={65} loading="eager" fetchpriority="high" />
          <Picture src={equipmentFront} alt="Техника Б/У с металлической рамой и транспортёрами, вид с другой стороны" width={480} widths={[240, 360, 480, 720]} sizes="(max-width: 767px) calc((min(100vw, 560px) - 64px) / 2), (max-width: 1199px) calc((100vw - 120px) / 4), (max-width: 1768px) calc((100vw - 448px) / 4), 330px" formats={["avif"]} fallbackFormat="webp" quality={65} loading="eager" />
        </div>
      </div>
      <p class="used-availability">Наличие восстановленной техники и условия покупки уточняйте в отделе продаж.</p>
    </header>

    <section id="trade-in" class="used-trade" aria-labelledby="trade-in-title">
      <div class="used-container used-trade__grid">
        <div class="used-trade__copy">
          <p class="eyebrow">Trade-in</p>
          <h2 id="trade-in-title">Ваша техника —<br />в зачёт новой</h2>
          <p>Предложите имеющуюся технику и оборудование в счёт покупки новой техники ИСВО. Согласованную стоимость зачтём при покупке.</p>
          <p class="used-trade__note">Возможность приёма, стоимость зачёта и доплата согласовываются индивидуально после оценки техники.</p>
          <a class="button button-primary" href="#offer-equipment">Обсудить Trade-in<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
        </div>
        <ol class="used-trade__steps" role="list">
          {tradeInSteps.map((step, index) => (
            <li>
              <span class="used-trade__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="offer-equipment" class="used-offer used-container" aria-labelledby="offer-equipment-title">
      <div class="used-offer__copy">
        <p class="eyebrow">Выкуп и Trade-in</p>
        <h2 id="offer-equipment-title">Предложите<br />свою технику</h2>
        <p>Отправьте описание и фотографии на почту. Укажите, что вас интересует: выкуп или зачёт в счёт новой техники.</p>
        <a class="button button-primary" href={contact.usedEquipmentEmailHref}>Отправить предложение<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
        <a class="used-offer__email" href={contact.usedEquipmentEmailHref}>{contact.email}</a>
        <div class="used-offer__phone"><span>Обсудить выкуп или наличие техники</span><a href={contact.phoneHref}>{contact.phone}</a><small>Бесплатно по России</small></div>
      </div>
      <div class="used-offer__details">
        <h3>Что указать в письме</h3>
        <ul role="list">
          {offerDetails.map(detail => <li><Check size={18} stroke-width={1.75} aria-hidden="true" focusable="false" /><span>{detail}</span></li>)}
        </ul>
      </div>
    </section>
  </article>
</SiteLayout>

<style>
  .used-container { max-width: 1500px; margin-inline: auto; padding-inline: var(--page-gutter); }
  .used-hero { padding-top: 40px; padding-bottom: clamp(48px, 6vw, 88px); }
  .used-hero__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 40px; }
  .eyebrow { margin: 0 0 20px; color: var(--color-green); font-size: var(--font-size-caption); font-weight: 700; line-height: 1.6; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.25rem, 4.2vw, 4rem); font-weight: 700; line-height: 1.08; letter-spacing: -.055em; }
  .used-hero__lead { margin: 24px 0; color: var(--color-green); font-size: clamp(1.5rem, 2.3vw, 2.25rem); font-weight: 700; line-height: 1.25; letter-spacing: -.04em; }
  .used-hero__description { max-width: 48ch; margin: 0 0 16px; color: var(--color-muted); }
  .used-hero__description a { color: var(--color-green); text-decoration: underline; text-underline-offset: 4px; }
  .used-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 24px; margin-top: 28px; }
  .used-text-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: var(--font-size-control); text-underline-offset: 5px; }
  .used-text-link svg { flex: none; }
  .used-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 16px; }
  .used-photos :global(picture) { display: block; overflow: hidden; border-radius: var(--radius-leaf-card); background: var(--color-line); }
  .used-photos :global(picture:last-child) { margin-top: 48px; }
  .used-photos :global(img) { display: block; width: 100%; height: auto; }
  .used-availability { margin: 40px 0 0; padding-top: 24px; border-top: 1px solid var(--color-line); color: var(--color-muted); font-size: var(--font-size-control); }
  h2 { margin: 0; font-size: clamp(1.875rem, 3vw, 3rem); line-height: 1.15; font-weight: 700; letter-spacing: -.045em; text-wrap: balance; }
  .used-trade { padding-block: clamp(48px, 6vw, 88px); color: var(--color-white); background: var(--color-green); scroll-margin-top: 24px; --focus-ring: 2px solid var(--color-yellow); }
  .used-trade__grid, .used-offer { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 5vw, 80px); }
  .used-trade .eyebrow { color: var(--color-yellow); }
  .used-trade__copy > p:not(.eyebrow) { max-width: 46ch; margin: 24px 0; color: rgb(255 255 255 / .85); }
  .used-trade__copy > .used-trade__note { font-size: var(--font-size-control); }
  .used-trade__steps { margin: 0; padding: 0; list-style: none; }
  .used-trade__steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 16px; padding-block: 24px; border-top: 1px solid rgb(255 255 255 / .3); }
  .used-trade__steps li:last-child { padding-bottom: 0; }
  .used-trade__number { padding-top: 4px; color: var(--color-yellow); font-size: var(--font-size-small); font-weight: 700; }
  .used-trade__steps h3 { margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.4; letter-spacing: -.025em; }
  .used-trade__steps p { margin: 12px 0 0; color: rgb(255 255 255 / .85); font-size: var(--font-size-body); }
  .used-offer { padding-block: clamp(48px, 6vw, 88px); scroll-margin-top: 24px; }
  .used-offer__copy > p:not(.eyebrow) { max-width: 46ch; margin: 24px 0 28px; color: var(--color-muted); }
  .used-offer__email { display: block; width: fit-content; min-height: 44px; padding-block: 12px 8px; font-size: var(--font-size-control); text-underline-offset: 4px; }
  .used-offer__phone { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; margin-top: 24px; }
  .used-offer__phone > span { font-size: var(--font-size-control); color: var(--color-muted); }
  .used-offer__phone a { display: inline-flex; align-items: center; min-height: 44px; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.3; font-weight: 700; letter-spacing: -.035em; text-decoration: none; white-space: nowrap; }
  .used-offer__phone small { font-size: var(--font-size-caption); color: var(--color-muted); }
  .used-offer__details { align-self: start; padding: clamp(24px, 3vw, 40px); border: 1px solid var(--color-line); border-radius: var(--radius-leaf-card); background: var(--color-white); }
  .used-offer__details h3 { margin: 0 0 28px; font-size: 1.5rem; font-weight: 700; line-height: 1.4; letter-spacing: -.025em; }
  .used-offer__details ul { display: grid; gap: 24px; margin: 0; padding: 0; list-style: none; }
  .used-offer__details li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 12px; color: var(--color-muted); }
  .used-offer__details svg { color: var(--color-green); margin-top: 4px; }
  @media (max-width: 767px) {
    .used-container { max-width: 560px; }
    .used-hero { padding-top: 24px; }
    .used-hero__grid, .used-trade__grid, .used-offer { grid-template-columns: 1fr; gap: 32px; }
    h1 { font-size: clamp(2.25rem, 9vw, 3.75rem); }
    .used-hero__lead { font-size: 1.75rem; }
    .used-photos :global(picture:last-child) { margin-top: 32px; }
    .used-availability { margin-top: 32px; }
    .used-offer { gap: 40px; }
  }
</style>
