---
import { Picture } from "astro:assets";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Check from "@lucide/astro/icons/check";
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { contact, sparePartsNavigation } from "../content/site";
import { sparePartGroups, partRequestHref } from "../content/spare-parts";
import { absoluteUrl, organizationId } from "../lib/structured-data";

const title = "Запчасти и сервис техники для овощеводства | ИСВО";
const description = "Транспортёрные ленты, гидромотор, ролики, оси и валы для оборудования ИСВО. Запросите подбор запасной части или обратитесь с вопросом по обслуживанию техники.";
const breadcrumbs = [{ label: "Главная", href: "/" }, sparePartsNavigation];
const mainEntity = {
  "@type": "Service",
  "@id": `${absoluteUrl(sparePartsNavigation.href)}#service`,
  url: absoluteUrl(sparePartsNavigation.href),
  name: sparePartsNavigation.label,
  description,
  serviceType: "Подбор запасных частей и обращения по обслуживанию оборудования ИСВО",
  provider: { "@id": organizationId },
};
const requestDetails = [
  { title: "Оборудование", text: "Модель и год выпуска, если известны. Фото машины и заводской таблички помогут уточнить исполнение." },
  { title: "Деталь или неисправность", text: "Название или маркировка, размеры и количество. Для сервисного обращения — что произошло и при каких условиях." },
  { title: "Фотографии", text: "Общий вид узла, сама деталь с разных сторон и место её установки. Размеры удобно показать рядом с линейкой." },
  { title: "Контакт для связи", text: "Ваше имя, хозяйство, телефон и регион. Укажите, к какому сроку нужна деталь или помощь." },
];
const serviceSteps = [
  { title: "Опишите ситуацию", text: "Укажите модель машины, что не работает и когда возникла проблема. Приложите фотографии или короткое видео." },
  { title: "Уточним задачу", text: "Обсудим состояние узла и необходимые исходные данные для подбора деталей или определения дальнейших действий." },
  { title: "Согласуем решение", text: "Возможность и состав работ, стоимость и сроки уточняются индивидуально после рассмотрения обращения." },
];
const heroImage = sparePartGroups[0].image;
---
<SiteLayout title={title} description={description} image={heroImage} breadcrumbs={breadcrumbs} mainEntity={mainEntity}>
  <article class="parts-page" aria-labelledby="parts-title">
    <header class="parts-hero parts-container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="parts-hero__grid">
        <div>
          <p class="eyebrow">Комплектующие и обслуживание</p>
          <h1 id="parts-title">{sparePartsNavigation.label}</h1>
          <p class="parts-hero__lead">Чтобы техника<br />продолжала работать</p>
          <p class="parts-hero__description">Ленты, гидромоторы, ролики и валы для оборудования ИСВО. Пришлите модель машины, фотографии и размеры детали — уточним исполнение и подготовим предложение.</p>
          <div class="parts-hero__actions">
            <a class="button button-primary" href="#parts-catalog">Найти запчасть<ArrowDown size={18} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
            <a class="text-link" href="#service-support">Обратиться по сервису<ArrowRight size={18} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
          </div>
        </div>
        <figure class="parts-hero__figure">
          <Picture src={heroImage.src} alt={heroImage.alt} width={640} widths={[320, 480, 640, 960]} sizes="(max-width: 767px) min(calc(100vw - 48px), 420px), (max-width: 1199px) calc((100vw - 104px) * .42), (max-width: 1768px) calc((100vw - 308px - 8.3vw) * .42), 529px" formats={["avif"]} fallbackFormat="webp" quality={70} loading="eager" fetchpriority="high" />
          <figcaption>Транспортёрная лента ИСВО<span>Пример исполнения с планками и пальцами</span></figcaption>
        </figure>
      </div>
    </header>

    <section id="parts-catalog" class="parts-catalog parts-container" aria-labelledby="parts-catalog-title">
      <div class="section-heading">
        <div><p class="eyebrow">Запасные части</p><h2 id="parts-catalog-title">Что нужно заменить?</h2></div>
        <p>Выберите группу или <a href="#parts-request">пришлите фото детали</a>, если не знаете её название. На фотографиях — примеры; совместимость, наличие, цену и срок поставки уточняем по запросу.</p>
      </div>
      <ul class="parts-grid" role="list">
        {sparePartGroups.map((group, index) => (
          <li>
            <article id={group.id} class="part-card" aria-labelledby={`${group.id}-title`}>
              <a class="part-card__photo" href={group.image.src.src} aria-label={`Открыть фото: ${group.image.alt}`}>
                <Picture src={group.image.src} alt={group.image.alt} width={640} widths={[320, 480, 640, 960]} sizes="(max-width: 767px) min(calc(100vw - 48px), 512px), (max-width: 1199px) calc((100vw - 88px) / 2), (max-width: 1768px) calc((100vw - 292px - 8.3vw) / 2), 658px" formats={["avif"]} fallbackFormat="webp" quality={70} loading="lazy" />
                <span class="part-card__open">Открыть фото<ArrowUpRight size={16} stroke-width={1.75} aria-hidden="true" focusable="false" /></span>
              </a>
              <div class="part-card__body">
                <span class="part-card__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <h3 id={`${group.id}-title`}>{group.title}</h3>
                <p>{group.description}</p>
                <p class="part-card__selection">{group.selection}</p>
                <a class="text-link part-card__request" href={partRequestHref(group.title)} aria-label={`Запросить подбор: ${group.title}`}>Запросить подбор<ArrowRight size={18} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
                {group.additionalImages.length > 0 && (
                  <details class="part-gallery">
                    <summary aria-label={`Ещё ${group.additionalImages.length} фото: ${group.title}`}>Ещё {group.additionalImages.length} фото</summary>
                    <ul class="part-gallery__images" role="list">
                      {group.additionalImages.map(photo => (
                        <li><a href={photo.src.src} aria-label={`Открыть фото: ${photo.alt}`}><Picture src={photo.src} alt={photo.alt} width={320} widths={[160, 240, 320, 480]} sizes="(max-width: 767px) min(calc((100vw - 108px) / 2), 226px), (max-width: 1199px) calc((100vw - 208px) / 4), (max-width: 1768px) calc((100vw - 412px - 8.3vw) / 4), 301px" formats={["avif"]} fallbackFormat="webp" quality={70} loading="lazy" /></a></li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <section id="service-support" class="parts-service" aria-labelledby="parts-service-title">
      <div class="parts-container parts-service__grid">
        <div class="parts-service__copy">
          <p class="eyebrow">Сервис</p>
          <h2 id="parts-service-title">Нужна помощь<br />с оборудованием?</h2>
          <p>Вопрос по обслуживанию, износ детали или неисправность — начните с описания ситуации. Чем подробнее исходные данные, тем проще определить следующий шаг.</p>
          <a class="button button-primary" href={contact.serviceEmailHref}>Написать по сервису<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
        </div>
        <ol class="parts-service__steps" role="list">
          {serviceSteps.map((step, index) => (
            <li><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="parts-request" class="parts-request parts-container" aria-labelledby="parts-request-title">
      <div class="parts-request__copy">
        <p class="eyebrow">Подбор по вашей машине</p>
        <h2 id="parts-request-title">Начните<br />с фотографии</h2>
        <p>Маркировка не сохранилась? Отправьте фото детали и места её установки. Если есть чертёж или список позиций, приложите их к письму.</p>
        <a class="button button-primary" href={contact.sparePartsEmailHref}>Отправить запрос<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
        <a class="parts-request__email" href={contact.sparePartsEmailHref}>{contact.email}</a>
        <p class="parts-request__attachment">Фотографии и файлы приложите в почтовом приложении.</p>
        <address class="parts-request__phone"><span>Удобнее обсудить по телефону?</span><a href={contact.phoneHref}>{contact.phone}</a><small>Бесплатно по России</small></address>
      </div>
      <div class="parts-request__checklist">
        <h3>Что указать в запросе</h3>
        <ul role="list">
          {requestDetails.map(item => (
            <li><Check size={18} stroke-width={1.75} aria-hidden="true" focusable="false" /><div><h4>{item.title}</h4><p>{item.text}</p></div></li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</SiteLayout>

<style>
  .parts-container { max-width: 1500px; margin-inline: auto; padding-inline: var(--page-gutter); }
  .parts-hero { padding-top: 40px; padding-bottom: clamp(48px, 6vw, 88px); }
  .parts-hero__grid { display: grid; grid-template-columns: minmax(0, .58fr) minmax(0, .42fr); gap: 40px; align-items: center; }
  .eyebrow { margin: 0 0 20px; color: var(--color-green); font-size: var(--font-size-caption); font-weight: 700; line-height: 1.6; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.25rem, 4.2vw, 4rem); line-height: 1.08; font-weight: 700; letter-spacing: -.055em; text-wrap: balance; }
  h2 { margin: 0; font-size: clamp(1.875rem, 3vw, 3rem); line-height: 1.15; font-weight: 700; letter-spacing: -.045em; text-wrap: balance; }
  .parts-hero__lead { margin: 24px 0; color: var(--color-green); font-size: clamp(1.5rem, 2.3vw, 2.25rem); line-height: 1.25; font-weight: 700; letter-spacing: -.04em; }
  .parts-hero__description { max-width: 49ch; margin: 0; color: var(--color-muted); }
  .parts-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 28px; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: var(--font-size-control); text-underline-offset: 5px; }
  .text-link svg { flex: none; }
  .parts-hero__figure { width: 100%; max-width: 420px; justify-self: end; margin: 0; }
  .parts-hero__figure :global(picture) { display: block; overflow: hidden; border-radius: var(--radius-leaf-card); background: var(--color-line); }
  .parts-hero__figure :global(img) { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 16px; color: var(--color-green); font-size: var(--font-size-control); font-weight: 700; line-height: 1.6; }
  figcaption span { display: block; color: var(--color-muted); font-size: var(--font-size-caption); font-weight: 500; }
  .parts-catalog { padding-block: clamp(40px, 5vw, 64px) clamp(48px, 6vw, 88px); border-top: 1px solid var(--color-line); }
  :is(.parts-catalog, .parts-service, .parts-request, .part-card) { scroll-margin-top: 24px; }
  .section-heading { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: end; gap: 24px; margin-bottom: 40px; }
  .section-heading > p { max-width: 52ch; margin: 0; color: var(--color-muted); font-size: var(--font-size-control); }
  .section-heading a { color: var(--color-green); text-decoration: underline; text-underline-offset: 4px; }
  .parts-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .part-card { height: 100%; overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-leaf-card); background: var(--color-white); }
  .part-card__photo { position: relative; display: block; background: #e5ebee; }
  .part-card__photo :global(picture) { display: block; }
  .part-card__photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; }
  .part-card__photo:focus-visible { outline-offset: -6px; }
  .part-card__open { position: absolute; right: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px; min-height: 32px; padding: 4px 10px; border-radius: var(--radius-leaf-control); background: var(--color-white); color: var(--color-green); font-size: var(--font-size-caption); }
  .part-card__photo:hover .part-card__open { background: var(--color-yellow); }
  .part-card__body { padding: clamp(20px, 2.2vw, 32px); }
  .part-card__number { display: block; margin-bottom: 12px; color: var(--color-green); font-size: var(--font-size-caption); font-weight: 700; }
  .part-card h3 { margin: 0; font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 700; line-height: 1.3; letter-spacing: -.035em; }
  .part-card__body > p { margin: 16px 0 0; color: var(--color-muted); font-size: var(--font-size-control); }
  .part-card__body > .part-card__selection { padding-top: 16px; border-top: 1px solid var(--color-line); }
  .part-card__request { margin-top: 20px; color: var(--color-green); font-weight: 700; }
  .part-gallery { margin-top: 16px; padding-top: 8px; border-top: 1px solid var(--color-line); }
  .part-gallery summary { width: fit-content; min-height: 44px; padding-block: 12px; color: var(--color-green); font-size: var(--font-size-control); line-height: 1.5; cursor: pointer; }
  .part-gallery__images { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 8px 0 0; padding: 0; list-style: none; }
  .part-gallery__images a, .part-gallery__images :global(picture) { display: block; }
  .part-gallery__images a { overflow: hidden; border-radius: var(--radius-leaf-control); background: #e5ebee; }
  .part-gallery__images :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: contain; }
  .parts-service { padding-block: clamp(48px, 6vw, 88px); color: var(--color-white); background: var(--color-green); --focus-ring: 2px solid var(--color-yellow); }
  .parts-service__grid, .parts-request { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 5vw, 80px); }
  .parts-service .eyebrow { color: var(--color-yellow); }
  .parts-service__copy > p:not(.eyebrow) { max-width: 46ch; margin: 24px 0 28px; color: rgb(255 255 255 / .85); }
  .parts-service__steps { margin: 0; padding: 0; list-style: none; }
  .parts-service__steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 16px; padding-block: 24px; border-top: 1px solid rgb(255 255 255 / .3); }
  .parts-service__steps li:last-child { padding-bottom: 0; }
  .parts-service__steps li > span { padding-top: 4px; color: var(--color-yellow); font-size: var(--font-size-small); font-weight: 700; }
  .parts-service__steps h3 { margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.4; letter-spacing: -.025em; }
  .parts-service__steps p { margin: 12px 0 0; color: rgb(255 255 255 / .85); }
  .parts-request { padding-block: clamp(48px, 6vw, 88px); }
  .parts-request__copy > p:not(.eyebrow):not(.parts-request__attachment) { max-width: 46ch; margin: 24px 0 28px; color: var(--color-muted); }
  .parts-request__email { display: block; width: fit-content; min-height: 44px; padding-block: 12px 8px; font-size: var(--font-size-control); text-underline-offset: 4px; }
  .parts-request__attachment { max-width: 36ch; margin: 0; color: var(--color-muted); font-size: var(--font-size-caption); }
  .parts-request__phone { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; margin-top: 28px; font-style: normal; }
  .parts-request__phone > span { font-size: var(--font-size-control); color: var(--color-muted); }
  .parts-request__phone a { display: inline-flex; align-items: center; min-height: 44px; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.3; font-weight: 700; letter-spacing: -.035em; text-decoration: none; white-space: nowrap; }
  .parts-request__phone small { font-size: var(--font-size-caption); color: var(--color-muted); }
  .parts-request__checklist { align-self: start; padding: clamp(24px, 3vw, 40px); border: 1px solid var(--color-line); border-radius: var(--radius-leaf-card); background: var(--color-white); }
  .parts-request__checklist h3 { margin: 0 0 28px; font-size: 1.5rem; font-weight: 700; line-height: 1.4; letter-spacing: -.025em; }
  .parts-request__checklist ul { display: grid; gap: 24px; margin: 0; padding: 0; list-style: none; }
  .parts-request__checklist li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 12px; }
  .parts-request__checklist svg { margin-top: 4px; color: var(--color-green); }
  .parts-request__checklist h4 { margin: 0 0 8px; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
  .parts-request__checklist p { margin: 0; color: var(--color-muted); font-size: var(--font-size-control); }
  @media (max-width: 767px) {
    .parts-container { max-width: 560px; }
    .parts-hero { padding-top: 24px; }
    .parts-hero__grid, .section-heading, .parts-grid, .parts-service__grid, .parts-request { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    h1 { font-size: clamp(2.25rem, 9vw, 3.75rem); }
    .parts-hero__lead { font-size: 1.75rem; }
    .parts-hero__figure { justify-self: center; }
    .section-heading { margin-bottom: 32px; gap: 24px; }
    .part-card__body { padding: 24px; }
    .part-card h3 { font-size: 1.5rem; }
    .parts-request { gap: 40px; }
  }
</style>
