---
import { getImage } from "astro:assets";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import ProductLinks from "../../../components/ProductLinks.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ProductMedia from "../../../components/ProductMedia.astro";
import ProductSpecifications from "../../../components/ProductSpecifications.astro";
import { equipmentDirections, directionHref } from "../../../content/equipment";
import { productHref, products, productsForDirection, type Product } from "../../../content/products";
import { contactsNavigation, equipmentNavigation } from "../../../content/site";
import { absoluteUrl, organizationId } from "../../../lib/structured-data";

export function getStaticPaths() {
  return products.map(product => ({ params: { direction: product.direction, product: product.slug }, props: { product } }));
}
interface Props { product: Product; }
const { product } = Astro.props;
const direction = equipmentDirections.find(item => item.id === product.direction)!;
const related = productsForDirection(product.direction).filter(item => item.slug !== product.slug);
const inquiryHref = `${contactsNavigation.href}?product=${encodeURIComponent(product.name)}#contact-panel-title`;
const schemaImage = product.image ? await getImage({ src: product.image.src, width: Math.min(1200, product.image.src.width), format: "webp", quality: 65 }) : undefined;
const breadcrumbs = [
  equipmentNavigation,
  { label: direction.title, href: directionHref(direction.id) },
  { label: product.name, href: productHref(product) },
];
const mainEntity = {
  "@type": "Product",
  "@id": `${absoluteUrl(productHref(product))}#product`,
  url: absoluteUrl(productHref(product)),
  name: `${product.name} — ${product.purpose}`,
  description: product.description,
  category: direction.title,
  manufacturer: { "@id": organizationId },
  brand: { "@id": organizationId },
  ...(schemaImage && { image: absoluteUrl(schemaImage.src) }),
  additionalProperty: product.specs.map(spec => ({ "@type": "PropertyValue", name: spec.label, value: spec.value })),
};
---
<SiteLayout title={`${product.seoTitle ?? `${product.name} — ${product.purpose}`} | ИСВО`} description={`${product.name}: ${product.description}`} image={product.image} breadcrumbs={breadcrumbs} mainEntity={mainEntity}>
  <article class="product-page" aria-labelledby="product-title">
    <Breadcrumbs items={breadcrumbs} />
    <header class="product-header"><p class="eyebrow">{direction.title}</p><h1 id="product-title" class="product-heading"><span class="product-model">{product.name}</span>{" "}<span class="product-purpose">{product.purpose}</span></h1></header>
    <div class:list={["product-overview", { "product-overview--with-image": product.image }]}>
      {product.image && <ProductMedia product={product} />}
      <div class="product-summary">
        <p class="product-description">{product.description}</p>
        {product.specs.length > 0 && <ProductSpecifications specs={product.specs} />}
        {product.specs.some(spec => spec.label.startsWith("Производительность")) && <p class="product-spec-note">Производительность приведена по КП и зависит от культуры, условий работы и организации процесса.</p>}
        <a class="button button-primary" href={inquiryHref} data-inquiry="product" data-inquiry-product={product.name} aria-haspopup="dialog">Запросить предложение<ArrowUpRight size={20} stroke-width={1.5} aria-hidden="true" focusable="false" /></a>
      </div>
    </div>
    <div class="product-details-grid">
      <section class="product-details" aria-labelledby="operation-title"><h2 id="operation-title">Как работает</h2>{product.operation.map(paragraph => <p>{paragraph}</p>)}</section>
      <section class="product-details" aria-labelledby="details-title"><h2 id="details-title">Особенности и применение</h2><ul>{product.features.map(feature => <li>{feature}</li>)}</ul></section>
    </div>
    <section class="product-selection" aria-labelledby="selection-title">
      <div><p class="eyebrow">Перед заказом</p><h2 id="selection-title">Подберём комплектацию<br />под вашу задачу</h2><a class="button button-primary" href={inquiryHref} data-inquiry="product-selection" data-inquiry-product={product.name} aria-haspopup="dialog">Запросить предложение<ArrowUpRight size={20} stroke-width={1.5} aria-hidden="true" focusable="false" /></a></div>
      <div>{product.selection.map(paragraph => <p>{paragraph}</p>)}</div>
    </section>
    <section class="related" aria-labelledby="related-title"><h2 id="related-title">Другая техника направления</h2><ProductLinks products={related} /></section>
  </article>
</SiteLayout>
<style>
  .product-page { max-width: 1600px; margin-inline: auto; padding: 40px var(--page-gutter) 80px; }
  .eyebrow { margin: 0 0 12px; font-size: var(--font-size-caption); font-weight: 700; color: var(--color-green); letter-spacing: .1em; text-transform: uppercase; }
  .product-header { margin-bottom: 32px; }
  .product-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; }
  h1 { margin: 0; font-size: clamp(2.2rem, 4.2vw, 4rem); font-weight: 700; letter-spacing: -.045em; line-height: 1.1; text-wrap: balance; }
  .product-model { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
  .product-purpose { flex: 1 1 22ch; max-width: 34ch; margin: 0; font-size: clamp(1.1rem, 1.8vw, 1.5rem); line-height: 1.4; font-weight: 500; letter-spacing: normal; color: var(--color-muted); }
  .product-overview { display: grid; gap: 32px; }
  .product-overview--with-image { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; gap: 40px; }
  .product-summary { min-width: 0; max-width: 70ch; }
  .product-description { margin: 0 0 24px; }
  h2 { font-size: clamp(1.5rem, 2vw, 2rem); font-weight: 700; letter-spacing: -.035em; line-height: 1.2; margin: 0 0 24px; }
  .product-spec-note { margin: -8px 0 24px; color: var(--color-muted); font-size: var(--font-size-caption); line-height: 1.6; }
  .product-details-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; margin-top: 48px; }
  .product-details { min-width: 0; padding-top: 32px; border-top: 1px solid var(--color-line); }
  .product-details p { max-width: 68ch; margin: 0 0 16px; color: var(--color-muted); }
  .product-details ul { max-width: 72ch; padding-left: 20px; margin: 0; } .product-details li { padding-left: 8px; margin-bottom: 12px; }
  .product-details li::marker { color: var(--color-green); }
  .product-selection { display: grid; grid-template-columns: 1fr 1.2fr; gap: 32px; margin-top: 40px; padding: clamp(24px, 3vw, 40px); border: 1px solid var(--color-line); border-radius: var(--radius-leaf-card); background: var(--color-white); }
  .product-selection h2 { margin-bottom: 24px; }
  .product-selection p:not(.eyebrow) { margin: 0 0 16px; color: var(--color-muted); }
  .product-selection p:last-child { margin-bottom: 0; }
  .related { margin-top: 56px; }
  @media (max-width: 1023px) { .product-overview--with-image { grid-template-columns: 1fr; } .product-details-grid, .product-selection { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 767px) { .product-page { padding-top: 24px; } .product-heading { display: block; } .product-purpose { display: block; margin-top: 16px; } .product-details-grid, .related { margin-top: 40px; } }
</style>
