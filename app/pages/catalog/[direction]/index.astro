---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import ProductLinks from "../../../components/ProductLinks.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { equipmentDirections, directionHref, type EquipmentDirection } from "../../../content/equipment";
import { productHref, productsForDirection } from "../../../content/products";
import { equipmentNavigation } from "../../../content/site";
import { absoluteUrl } from "../../../lib/structured-data";

export function getStaticPaths() {
  return equipmentDirections.map(direction => ({ params: { direction: direction.id }, props: { direction } }));
}
interface Props { direction: EquipmentDirection; }
const { direction } = Astro.props;
const directionProducts = productsForDirection(direction.id);
const breadcrumbs = [
  equipmentNavigation,
  { label: direction.title, href: directionHref(direction.id) },
];
const mainEntity = {
  "@type": "ItemList",
  "@id": `${absoluteUrl(directionHref(direction.id))}#products`,
  name: direction.title,
  numberOfItems: directionProducts.length,
  itemListElement: directionProducts.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: product.name,
    url: absoluteUrl(productHref(product)),
  })),
};
---
<SiteLayout title={`${direction.title} — техника ИСВО`} description={direction.description} pageType="CollectionPage" breadcrumbs={breadcrumbs} mainEntity={mainEntity}>
  <div class="catalog-page">
    <Breadcrumbs items={breadcrumbs} />
    <header><p class="eyebrow">Каталог техники</p><h1>{direction.title}</h1><p class="intro">{direction.description}</p></header>
    <nav class="directions" aria-label="Направления техники">
      {equipmentDirections.map(item => <a href={directionHref(item.id)} aria-current={item.id === direction.id ? "page" : undefined}>{item.title}</a>)}
    </nav>
    <ProductLinks products={directionProducts} />
  </div>
</SiteLayout>
<style>
  .catalog-page { --breadcrumbs-spacing: 56px; padding: 40px var(--page-gutter) 80px; max-width: 1400px; margin-inline: auto; }
  .eyebrow { color: var(--color-green); font-size: var(--font-size-caption); text-transform: uppercase; letter-spacing: .1em; font-weight: 700; }
  h1 { margin: 12px 0 20px; font-size: var(--font-size-section); font-weight: 700; line-height: 1.1; letter-spacing: -.045em; text-wrap: balance; }
  .intro { color: var(--color-muted); max-width: 50ch; margin-bottom: 40px; }
  .directions { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .directions a { display: flex; align-items: center; min-height: 44px; padding: 10px 16px; border: 1px solid var(--color-line); border-radius: var(--radius-leaf-control); text-decoration: none; font-size: var(--font-size-control); }
  .directions a[aria-current="page"] { background: var(--color-green); border-color: var(--color-green); color: white; }
  .directions a:hover { border-color: var(--color-green); }
  @media (max-width: 767px) { .catalog-page { padding-top: 24px; } }
</style>
