---
import Icon from "./Icon.astro";
import HeroGallery from "./HeroGallery.astro";
import { contact } from "../content/site";
const benefits = [
  { icon: "factory", lines: ["Собственное", "производство"] },
  { icon: "engineering", lines: ["Разработка под\u00a0задачу", "хозяйства"] },
  { icon: "service", lines: ["Сервис", "и\u00a0запасные части"] },
] as const;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-eyebrow"><span></span>Собственное производство<br />с&nbsp;2007&nbsp;года</p>
    <h1 id="hero-title">Техника<br />для&nbsp;выращивания<br />и&nbsp;уборки овощей</h1>
    <p class="hero-description">Оборудование для&nbsp;посадки, ухода, уборки и&nbsp;транспортировки урожая.</p>
    <div class="hero-actions">
      <a class="button button-primary" href={contact.emailHref} data-inquiry="hero">Получить предложение<Icon name="arrow" size={20} /></a>
      <HeroGallery />
      <a class="button button-secondary" href="#equipment-selector" data-equipment-selector>Подобрать технику<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none"><path d="M8 3v10m-4-4 4 4 4-4" stroke="currentColor" stroke-width="1.3" /></svg></a>
    </div>
    <ul class="hero-benefits" role="list" aria-label="Наши преимущества">
      {benefits.map(({ icon, lines }) => <li><Icon name={icon} /><span>{lines[0]}<br />{lines[1]}</span></li>)}
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; display: grid; align-items: center; min-height: calc(100svh - var(--site-header-height)); overflow: clip; background: var(--color-paper); }
  .hero-content { padding: 61px clamp(32px, 4.15vw, 80px) 42px; }
  /* Keep the gallery anchored to the Hero while its DOM order follows the mobile reading order. */
  .hero-content > :not(.hero-actions), .hero-actions > .button { position: relative; z-index: 2; }
  .hero-eyebrow { position: relative; margin: 0 0 30px; padding-left: 31px; font-size: var(--font-size-caption); font-weight: 700; line-height: 1.6; letter-spacing: .1em; text-transform: uppercase; color: var(--color-green); }
  .hero-eyebrow > span { position: absolute; left: 5px; top: 1px; width: 3px; height: 31px; background: var(--color-yellow); transform: skewX(-35deg); }
  h1 { max-width: 690px; margin: 0; font-size: clamp(46px, 4.45vw, 68px); font-weight: 700; line-height: 1.08; letter-spacing: -.055em; }
  .hero-description { max-width: 480px; margin: 26px 0 0; color: var(--color-muted); font-size: var(--font-size-body); line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 31px; }
  .hero-benefits { display: flex; flex-wrap: wrap; gap: 28px; padding: 0; margin: 47px 0 0; list-style: none; }
  .hero-benefits li { display: flex; align-items: center; gap: 10px; color: var(--color-green); }
  .hero-benefits li span { color: var(--color-ink); font-size: var(--font-size-small); font-weight: 500; line-height: 1.6; }
  .hero-benefits svg { flex: none; }
  @media (min-width: 1600px) {
    .hero-content { padding-top: 82px; }
    .hero-benefits { margin-top: 60px; }
  }
  @media (min-width: 768px) and (max-width: 1199px) {
    .hero-content { padding: 64px 32px 38px; }
    h1 { font-size: clamp(42px, 4.45vw, 54px); }
    .hero-description { max-width: 400px; }
    .hero-actions { gap: 10px; }
    .hero-actions .button { padding-inline: 16px; }
    .hero-actions [data-inquiry="hero"] { display: none; }
    .hero-benefits { gap: 21px; }
  }
  @media (min-width: 768px) and (max-height: 760px) {
    .hero-content { padding-block: 32px; }
    .hero-eyebrow { margin-bottom: 22px; }
    .hero-description { margin-top: 20px; }
    .hero-actions { margin-top: 24px; }
    .hero-benefits { margin-top: 32px; }
  }
  @media (max-width: 767px) {
    .hero { display: block; }
    .hero-content { width: 100%; max-width: 560px; margin-inline: auto; padding: 28px 24px 32px; }
    .hero-eyebrow { margin-bottom: 20px; }
    h1 { font-size: clamp(32px, 9.55vw, 54px); line-height: 1.11; letter-spacing: -.055em; }
    .hero-description { margin-top: 18px; }
    .hero-actions { flex-direction: column; align-items: stretch; gap: 16px; margin-top: 22px; }
    .hero-actions .button { justify-content: space-between; min-height: 50px; padding-inline: 20px; }
    .hero-benefits { display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 12px; margin-top: 28px; }
    .hero-benefits li { flex-direction: column; align-items: flex-start; gap: 9px; }
    .hero-benefits li span { font-size: var(--font-size-caption); }
  }
  @media (max-width: 374px) {
    .hero-benefits { grid-template-columns: 1fr; gap: 16px; }
    .hero-benefits li { flex-direction: row; align-items: center; gap: 12px; }
  }
</style>
