---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import markUrl from "../assets/brand/isvo-mark.svg?url";
import { contact } from "../content/site";
import { equipmentDirections, directionHref } from "../content/equipment";

const year = new Date().getFullYear();
---
<footer class="site-footer" id="contacts" aria-label="Контакты и каталог ИСВО">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="/" aria-label="ИСВО — главная">
          <img src={markUrl} width="304" height="192" alt="Фирменный знак ИСВО" />
        </a>
        <p>Проектируем и производим технику для овощеводства с&nbsp;2007&nbsp;года.</p>
      </div>

      <section class="site-footer__contacts" aria-labelledby="footer-contacts-title">
        <h2 id="footer-contacts-title" class="site-footer__label">Отдел продаж</h2>
        <address>
          <a class="site-footer__phone" href={contact.phoneHref}>{contact.phone}</a>
          <span class="site-footer__note">Бесплатно по России</span>
        </address>
        <a class="button button-primary site-footer__cta" href={contact.emailHref} data-inquiry="footer">
          Получить предложение<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" />
        </a>
      </section>

      <nav class="site-footer__catalog" aria-labelledby="footer-catalog-title">
        <h2 id="footer-catalog-title" class="site-footer__label">Техника</h2>
        <ul role="list">
          {equipmentDirections.map(direction => (
            <li><a href={directionHref(direction.id)} aria-current={Astro.url.pathname === directionHref(direction.id) ? "page" : undefined}>{direction.title}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} ИСВО</p>
      <p class="site-footer__signature">Инженерия. Производство. Сервис.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-left: var(--sidebar-width);
    padding: 56px var(--page-gutter) 20px;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
    background: var(--color-white);
    scroll-margin-top: 24px;
  }
  .site-footer__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); padding-bottom: 40px; }
  .site-footer__grid > * { min-width: 0; }
  .site-footer__logo { display: block; flex: none; width: 51px; max-width: 100%; }
  .site-footer__logo img { display: block; width: 100%; height: auto; filter: grayscale(1); opacity: .65; }
  .site-footer__brand p { max-width: 28ch; margin: var(--space-3) 0 0; color: var(--color-muted); font-size: var(--font-size-control); line-height: 1.8; }
  .site-footer__label { margin: 0 0 16px; color: var(--color-muted); font-size: var(--font-size-caption); line-height: 1.5; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .site-footer__contacts { display: none; }
  address { display: flex; flex-direction: column; align-items: flex-start; font-style: normal; }
  .site-footer a { text-decoration: none; }
  .site-footer__phone { display: inline-flex; align-items: center; min-height: 44px; font-size: clamp(1.375rem, 2vw, 1.75rem); line-height: 1.3; font-weight: 700; letter-spacing: -.035em; white-space: nowrap; }
  .site-footer__note { color: var(--color-muted); font-size: var(--font-size-caption); }
  .site-footer__cta { justify-content: space-between; gap: 12px; max-width: 100%; margin-top: 16px; padding-inline: 16px; }
  .site-footer__catalog ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__catalog a { display: flex; align-items: center; min-height: 44px; padding-block: 8px; font-size: var(--font-size-control); line-height: 1.5; }
  .site-footer__catalog a[aria-current] { color: var(--color-green); }
  .site-footer__bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; padding-top: 16px; border-top: 1px solid var(--color-line); color: var(--color-muted); font-size: var(--font-size-caption); }
  .site-footer__bottom p { margin: 0; }
  @media (min-width: 768px) and (max-width: 1199px) {
    .site-footer__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); }
    .site-footer__contacts { display: block; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: 1 / -1; display: flex; align-items: center; gap: var(--space-3); }
    .site-footer__brand p { max-width: 36ch; margin: 0; }
  }
  @media (max-width: 599px) {
    .site-footer { padding-top: 40px; }
    .site-footer__inner { max-width: 512px; margin-inline: auto; }
    .site-footer__grid { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-bottom: 32px; }
    .site-footer__brand p { max-width: 34ch; }
    .site-footer__signature { flex-basis: 100%; order: 1; }
  }
</style>
