---
import { Picture } from "astro:assets";
import ZoomIn from "@lucide/astro/icons/zoom-in";
import type { ProductImage } from "../content/products";

interface Props {
  photo: ProductImage;
  href: string;
  index: number;
  count: number;
  fullWidth?: boolean;
}
const { photo, href, index, count, fullWidth = false } = Astro.props;
const main = index === 0;
---
<a class:list={["product-media__photo", { "product-media__photo--main": main }]}
  href={href} data-product-photo data-media-title={photo.alt}
  aria-label={`Увеличить фото ${index + 1} из ${count}: ${photo.alt}`} aria-haspopup="dialog">
  <Picture src={photo.src} alt={photo.alt} width={main ? 800 : 480}
    widths={main ? [320, 480, 640, 800] : [160, 240, 320, 480]}
    sizes={main ? (fullWidth ? "(max-width: 767px) calc(100vw - 48px), (max-width: 1023px) min(calc(100vw - 64px), 720px), (max-width: 1199px) calc((100vw - 104px) * .55), (max-width: 1868px) calc((100vw - 308px - 8.3vw) * .55), 764px" : "(max-width: 639px) min(calc(100vw - 48px), 330px), (max-width: 1023px) 390px, (max-width: 1199px) 300px, (max-width: 1599px) 340px, 440px") : "(max-width: 639px) calc((100vw - 68px) / 3), (max-width: 1023px) 240px, 260px"}
    formats={["avif"]} fallbackFormat="webp" quality={75} loading={main ? "eager" : "lazy"} fetchpriority={main ? "high" : "auto"} />
  {main && <span class="product-media__zoom"><ZoomIn size={16} stroke-width={1.75} aria-hidden="true" focusable="false" />Увеличить</span>}
</a>
<style>
  .product-media__photo { position: relative; display: block; min-width: 0; overflow: hidden; border-radius: var(--radius-small); cursor: zoom-in; }
  .product-media__photo:focus-visible { outline-offset: -4px; }
  .product-media__photo :global(picture) { display: block; }
  .product-media__photo :global(img) { display: block; width: 100%; height: auto; }
  .product-media__photo--main { width: fit-content; max-width: 100%; margin-inline: auto; border-radius: var(--radius-leaf-card); }
  .product-media__photo--main :global(img) { width: auto; max-width: 100%; max-height: 440px; }
  .product-media__zoom { position: absolute; right: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: var(--radius-leaf-control); background: var(--color-white); color: var(--color-green); font-size: var(--font-size-caption); font-weight: 700; }
  .product-media__photo:hover .product-media__zoom { background: var(--color-yellow); }
</style>
