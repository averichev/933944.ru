---
import type { Product } from "../content/products";
interface Props { specs: Product["specs"]; }
const { specs } = Astro.props;
---
<table class="product-specifications">
  <caption>Технические характеристики</caption>
  <tbody>
    {specs.map(spec => <tr><th scope="row">{spec.label}</th><td>{spec.value}</td></tr>)}
  </tbody>
</table>
<style>
  .product-specifications { width: 100%; margin: 0 0 28px; border-collapse: separate; border-spacing: 0; overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-small); background: var(--color-white); font-size: var(--font-size-control); line-height: 1.55; }
  caption { padding: 0 0 14px; text-align: left; color: var(--color-green); font-size: 1rem; font-weight: 700; }
  th, td { padding: 13px 16px; vertical-align: top; text-align: left; }
  th { width: 55%; color: var(--color-muted); font-weight: 500; overflow-wrap: anywhere; }
  td { font-weight: 700; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  tr:nth-child(even) { background: color-mix(in srgb, var(--color-paper) 65%, var(--color-white)); }
  tr + tr > * { border-top: 1px solid color-mix(in srgb, var(--color-line) 65%, var(--color-white)); }
  @media (max-width: 374px) { th, td { padding: 12px 10px; } }
</style>
