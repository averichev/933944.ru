---
import { getImage } from "astro:assets";
import { heroGallery, heroPhotos } from "../content/hero";

const photos = await Promise.all(heroPhotos.map(async (photo) => {
  // Do not upscale smaller catalog photos, including the 1600px seeding photo.
  const widths = [...new Set([480, 640, 800, 1280, 1920].map((width) => Math.min(width, photo.image.width)))];
  const fallbackIndex = widths.indexOf(Math.min(1280, photo.image.width));
  const optimize = async (format: "avif" | "webp", quality: number) => {
    const images = await Promise.all(widths.map((width) => getImage({ src: photo.image, width, format, quality })));
    return { src: images[fallbackIndex].src, srcset: images.map((image, index) => `${image.src} ${widths[index]}w`).join(", ") };
  };
  const [avif, webp] = await Promise.all([optimize("avif", 45), optimize("webp", 76)]);
  return { ...photo, avif, webp };
}));
---
<div class="hero-photo" data-hero-gallery data-hold={heroGallery.holdMs} data-fade={heroGallery.fadeMs}>
  {photos.map((photo, index) => index === 0 ? (
    <picture class="hero-slide is-active" data-product={photo.id} style={`--hero-focus: ${photo.focus}; --hero-mobile-focus: ${photo.mobileFocus}`}>
      <source type="image/avif" srcset={photo.avif.srcset} sizes={heroGallery.sizes} />
      <img src={photo.webp.src} srcset={photo.webp.srcset} sizes={heroGallery.sizes} width={photo.image.width} height={photo.image.height} alt={photo.label} loading="eager" fetchpriority="high" decoding="async" />
    </picture>
  ) : (
    <template data-hero-slide>
      <picture class="hero-slide" data-product={photo.id} aria-hidden="true" style={`--hero-focus: ${photo.focus}; --hero-mobile-focus: ${photo.mobileFocus}`}>
        <source type="image/avif" srcset={photo.avif.srcset} sizes={heroGallery.sizes} />
        <img src={photo.webp.src} srcset={photo.webp.srcset} sizes={heroGallery.sizes} width={photo.image.width} height={photo.image.height} alt={photo.label} loading="eager" fetchpriority="low" decoding="async" />
      </picture>
    </template>
  ))}
</div>

<script>
  import "../scripts/hero-gallery";
</script>

<style>
  .hero-photo { position: absolute; z-index: 0; inset: 0 0 0 28%; pointer-events: none; }
  .hero-slide { position: absolute; inset: 0; display: block; opacity: 0; }
  .hero-slide.is-active { opacity: 1; z-index: 1; }
  .hero-slide.is-incoming { z-index: 2; }
  .hero-slide img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--hero-focus); }
  .hero-photo::after { position: absolute; z-index: 3; inset: 0 -1px; content: ""; background: linear-gradient(90deg, var(--color-paper) 0%, rgb(246 245 240 / .98) 9%, rgb(246 245 240 / .95) 25%, rgb(246 245 240 / .88) 33%, rgb(246 245 240 / .47) 49%, transparent 65%); }
  @media (min-width: 768px) and (max-width: 1199px) {
    .hero-photo { left: 17%; }
    .hero-photo::after { background: linear-gradient(90deg, var(--color-paper), rgb(246 245 240 / .95) 25%, rgb(246 245 240 / .88) 40%, rgb(246 245 240 / .47) 60%, transparent 85%); }
  }
  @media (max-width: 767px) {
    .hero-photo { position: relative; inset: auto; flex: none; width: 100%; height: clamp(200px, 60vw, 320px); }
    .hero-slide img { object-position: var(--hero-mobile-focus); }
    .hero-photo::after { background: linear-gradient(180deg, var(--color-paper), rgb(246 245 240 / .4) 8px, transparent 24px); }
  }
</style>
