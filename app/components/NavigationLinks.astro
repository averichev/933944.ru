---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { contact, equipmentNavigation, navigation } from "../content/site";
---
<nav aria-label="Основная навигация">
  <ul class="navigation-links" role="list">
    {navigation.map((item) => {
      const current = Astro.url.pathname === item.href ? "page" :
        item.href === equipmentNavigation.href && Astro.url.pathname.startsWith("/catalog/") ? "location" : undefined;
      const Tag = current ? "span" : "a";
      return <li>{item.href ?
        <Tag class="navigation-link" href={current ? undefined : item.href} aria-current={current}>{item.label}<ArrowUpRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></Tag> :
        <span class="navigation-unavailable" aria-disabled="true" title="Раздел готовится">{item.label}<small>Скоро</small></span>
      }</li>;
    })}
    <li><a class="navigation-link" href={contact.emailHref} data-inquiry="navigation">Контакты</a></li>
  </ul>
</nav>
