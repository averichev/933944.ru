---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { equipmentNavigation, navigation } from "../content/site";
---
<nav aria-label="Основная навигация">
  <ul class="navigation-links" role="list">
    {navigation.map((item) => {
      const current = Astro.url.pathname === item.href ? "page" :
        item.href === equipmentNavigation.href && Astro.url.pathname.startsWith("/catalog/") ? "location" : undefined;
      return <li><a class="navigation-link" href={item.href} aria-current={current}>{item.label}<ArrowUpRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a></li>;
    })}
  </ul>
</nav>
