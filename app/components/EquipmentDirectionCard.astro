---
import { getImage } from "astro:assets";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import type { EquipmentDirection } from "../content/equipment";
import { productHref, productsForDirection } from "../content/products";

interface Props {
  direction: EquipmentDirection;
  variant?: "stacked" | "split" | "featured" | "wide";
  /** The parent layout owns the image's display width. */
  sizes: string;
  headingLevel?: "h2" | "h3";
}

const { direction, variant = "stacked", sizes, headingLevel: Heading = "h3" } = Astro.props;
const { image } = direction;
const titleId = `direction-${direction.id}`;
const directionProducts = productsForDirection(direction.id);
const widths = [...new Set([320, 480, 640, 800, 1280, 1920].map(width => Math.min(width, image.src.width)))];
const optimize = async (format: "avif" | "webp", quality: number) => {
  const images = await Promise.all(widths.map(width => getImage({ src: image.src, width, format, quality })));
  return {
    src: images[widths.indexOf(Math.min(800, image.src.width))].src,
    srcset: images.map((result, index) => `${result.src} ${widths[index]}w`).join(", "),
  };
};
const [avif, webp] = await Promise.all([optimize("avif", 45), optimize("webp", 76)]);
---
<article class:list={["direction-card", `direction-card--${variant}`]} aria-labelledby={titleId} style={`--image-focus: ${image.focus}; --image-mobile-focus: ${image.mobileFocus}`}>
  <div class="direction-card__media">
    <picture>
      <source type="image/avif" srcset={avif.srcset} sizes={sizes} />
      <img src={webp.src} srcset={webp.srcset} sizes={sizes} width={image.src.width} height={image.src.height} alt={image.alt} loading="lazy" decoding="async" fetchpriority="low" />
    </picture>
  </div>
  <div class="direction-card__body">
    <Heading id={titleId}>{direction.title}</Heading>
    <p class="direction-card__description">{direction.description}</p>
    <ul class="direction-card__products" role="list" aria-label={`Модели: ${direction.title.toLowerCase()}`}>
      {directionProducts.map(product => (
        <li>
          <a class="direction-card__product" href={productHref(product)}>
            <span><strong>{product.name}</strong><span class="direction-card__purpose">{product.purpose}</span></span>
            <ArrowUpRight size={18} stroke-width={1.5} aria-hidden="true" focusable="false" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .direction-card {
    --card-padding: clamp(20px, 2vw, 32px);
    --card-line: var(--color-line);
    --card-hover: rgb(8 97 55 / .06);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    color: var(--color-ink);
    background: var(--color-white);
    border-radius: var(--radius-leaf-card);
    overflow: clip;
  }
  .direction-card__media { position: relative; min-width: 0; overflow: hidden; background: var(--color-line); }
  .direction-card__media picture { display: block; height: 100%; }
  .direction-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--image-focus); transition: transform var(--duration-image) var(--ease-out); }
  .direction-card__body { display: flex; flex-direction: column; flex: 1; min-width: 0; padding: var(--card-padding); }
  h2, h3 { margin: 0; font-size: var(--font-size-card); line-height: 1.15; font-weight: 700; letter-spacing: -.045em; text-wrap: balance; }
  a svg { flex: none; transition: transform var(--duration-fast) ease; }
  .direction-card__description { margin: var(--space-3) 0 var(--space-4); font-size: var(--font-size-control); line-height: 1.65; max-width: 42ch; }
  .direction-card__products { margin: auto 0 0; padding: 0; list-style: none; }
  .direction-card__products li + li { border-top: 1px solid var(--card-line); }
  .direction-card__product { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: 56px; padding: var(--space-3) var(--space-4); text-decoration: none; border-radius: var(--radius-small); transition: background-color var(--duration-fast) ease; }
  .direction-card__product > span { min-width: 0; }
  .direction-card__product strong { display: block; font-size: 1rem; font-weight: 700; line-height: 1.4; }
  .direction-card__purpose { display: block; margin-top: 3px; font-size: var(--font-size-control); line-height: 1.5; color: var(--color-muted); }
  .direction-card--stacked .direction-card__media { aspect-ratio: 2.3; }

  .direction-card--featured { background: var(--color-green); color: var(--color-white); }
  .direction-card--featured .direction-card__media { flex: 1; min-height: 360px; }
  .direction-card--featured .direction-card__media picture { position: absolute; inset: 0; }
  .direction-card--featured .direction-card__body { flex: none; padding: var(--space-8); }
  .direction-card--featured h2, .direction-card--featured h3 { font-size: clamp(2rem, 2.7vw, 2.75rem); }
  .direction-card--featured .direction-card__description { font-size: var(--font-size-body); }
  .direction-card--featured, .direction-card--split { --card-line: rgb(255 255 255 / .3); --card-hover: rgb(255 255 255 / .08); }
  .direction-card--featured .direction-card__purpose,
  .direction-card--split .direction-card__purpose { color: var(--color-white); opacity: .85; }
  .direction-card--featured a:focus-visible { outline-color: var(--color-yellow); }

  .direction-card--split { display: grid; grid-template-columns: minmax(0, 1fr) 38%; background: var(--color-terracotta); color: var(--color-white); border: 1px solid var(--color-terracotta); }
  .direction-card--split a:focus-visible { outline-color: var(--color-white); }
  .direction-card--split .direction-card__media { grid-column: 2; grid-row: 1; }
  .direction-card--split .direction-card__media picture { position: absolute; inset: 0; }
  .direction-card--split .direction-card__body { grid-column: 1; grid-row: 1; }

  .direction-card--wide { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
  .direction-card--wide .direction-card__media { min-height: 360px; }
  .direction-card--wide .direction-card__media picture { position: absolute; inset: 0; }

  @media (hover: hover) and (pointer: fine) {
    .direction-card__product:hover { background: var(--card-hover); }
    a:hover svg { transform: translate(2px, -2px); }
  }
  @media (min-width: 768px) and (max-width: 1199px) {
    .direction-card--featured { display: grid; grid-template-columns: 1.2fr 1fr; }
    .direction-card--featured .direction-card__media { min-height: 320px; }
    .direction-card--featured .direction-card__body { padding: var(--space-6); justify-content: center; }
    .direction-card--featured .direction-card__description { font-size: var(--font-size-control); }
    .direction-card--featured h2, .direction-card--featured h3 { font-size: var(--font-size-card); }
    .direction-card--split { display: flex; border: 0; }
    .direction-card--split .direction-card__media { aspect-ratio: 1.5; }
    .direction-card--stacked .direction-card__media { aspect-ratio: 1.5; }
  }
  @media (max-width: 767px) {
    .direction-card { --card-padding: 24px; }
    .direction-card__media img { object-position: var(--image-mobile-focus); }
    .direction-card--stacked .direction-card__media { aspect-ratio: 1.7; }
    .direction-card--featured .direction-card__media { flex: none; min-height: 0; aspect-ratio: 1.25; }
    .direction-card--featured .direction-card__body { padding: var(--card-padding); }
    .direction-card--featured h2, .direction-card--featured h3 { font-size: 1.875rem; }
    .direction-card--featured .direction-card__description { font-size: var(--font-size-control); }
    .direction-card--split { grid-template-columns: minmax(0, 1fr) 32%; }
    .direction-card--wide { display: flex; }
    .direction-card--wide .direction-card__media { min-height: 0; aspect-ratio: 1.7; }
  }
  @media (max-width: 374px) {
    .direction-card { --card-padding: 20px; }
    .direction-card--split { display: flex; }
    .direction-card--split .direction-card__media { height: 160px; }
  }
</style>
