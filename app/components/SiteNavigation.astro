---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import Brand from "./Brand.astro";
import NavigationLinks from "./NavigationLinks.astro";
import NavigationContacts from "./NavigationContacts.astro";
import VineDivider from "./VineDivider.astro";
import { contact, equipmentNavigation } from "../content/site";
import "./navigation.css";

const equipmentCurrent = Astro.url.pathname.startsWith("/catalog/") ? "location" : undefined;
const EquipmentTag = equipmentCurrent ? "span" : "a";
---
<header class="site-navigation" aria-label="Навигация и контакты ИСВО">
  <Brand />
  <VineDivider id="header-vine" />
  <NavigationLinks />
  <NavigationContacts showEmail={false} />
</header>
<header class="mobile-header">
  <Brand compact />
  <nav class="mobile-header-actions" aria-label="Быстрая навигация">
    <EquipmentTag class="mobile-equipment-link" href={equipmentCurrent ? undefined : equipmentNavigation.href} aria-current={equipmentCurrent}>{equipmentNavigation.label}</EquipmentTag>
    <button type="button" class="menu-toggle" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false">
      <Menu size={18} stroke-width={1.75} aria-hidden="true" focusable="false" /><span>Меню</span>
    </button>
  </nav>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Меню сайта">
  <div class="mobile-menu-top">
    <Brand />
    <button class="close-button" type="button" aria-label="Закрыть меню" data-close-dialog autofocus>
      <X size={22} stroke-width={1.75} aria-hidden="true" focusable="false" />
    </button>
  </div>
  <NavigationLinks />
  <NavigationContacts />
</dialog>
<dialog class="inquiry-dialog" aria-labelledby="inquiry-title" aria-describedby="inquiry-description">
  <button class="close-button inquiry-close" type="button" aria-label="Закрыть окно" data-close-dialog>
    <X size={20} stroke-width={1.75} aria-hidden="true" focusable="false" />
  </button>
  <p class="dialog-eyebrow">Напрямую с производителем</p>
  <h2 id="inquiry-title">Обсудим ваше хозяйство</h2>
  <p id="inquiry-description">Расскажите, какие овощи выращиваете и какую задачу хотите решить. Специалисты ИСВО помогут подобрать оборудование.</p>
  <a class="dialog-phone" href={contact.phoneHref}>{contact.phone}</a>
  <p class="contact-note">бесплатно по России</p>
  <a class="button button-primary" href={contact.emailHref}>Написать в отдел продаж<ArrowRight size={20} stroke-width={1.75} aria-hidden="true" focusable="false" /></a>
  <a class="dialog-email" href={`mailto:${contact.email}`}>{contact.email}</a>
</dialog>

<script>
  import "../scripts/navigation";
</script>
