---
import "../globals.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../content/site";
import defaultImage from "../assets/hero-harvest-platform.jpg";
import SiteNavigation from "../components/SiteNavigation.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteUrl, createPageSchema, serializeJsonLd, type BreadcrumbItem, type SchemaEntity } from "../lib/structured-data";
import manropeRegular from "../assets/fonts/manrope-500.woff2?url";
import manropeBold from "../assets/fonts/manrope-700.woff2?url";
interface Props {
  title: string;
  description: string;
  pageType?: "WebPage" | "CollectionPage" | "AboutPage" | "ContactPage";
  breadcrumbs?: readonly BreadcrumbItem[];
  mainEntity?: SchemaEntity;
  image?: { src: ImageMetadata; alt: string };
  noindex?: boolean;
}
const { title, description, pageType, breadcrumbs, mainEntity, image = { src: defaultImage, alt: "Техника ИСВО для уборки овощей в поле" }, noindex = false } = Astro.props;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
// JPEG is understood by link-preview crawlers; keep the photograph's proportions.
// A meta image is downloaded by crawlers, without adding a request to the page.
const preview = await getImage({ src: image.src, width: Math.min(1200, image.src.width), format: "jpeg", quality: 80 });
const previewImage = { url: absoluteUrl(preview.src), width: Number(preview.attributes.width), height: Number(preview.attributes.height), caption: image.alt };
const structuredData = createPageSchema({ title, description, pathname: Astro.url.pathname, pageType, breadcrumbs, mainEntity, image: previewImage });
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#086137" />
    <title>{title}</title>
    {!noindex && <>
      <link rel="canonical" href={canonicalUrl} />
      <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
      <meta property="og:type" content="website" />
      <meta property="og:locale" content="ru_RU" />
      <meta property="og:site_name" content={site.name} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:image" content={previewImage.url} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content={String(previewImage.width)} />
      <meta property="og:image:height" content={String(previewImage.height)} />
      <meta property="og:image:alt" content={image.alt} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={previewImage.url} />
      <meta name="twitter:image:alt" content={image.alt} />
      <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    </>}
    <link rel="icon" href="/favicon.svg?v=1" type="image/svg+xml" sizes="any" />
    <link rel="preload" href={manropeBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeRegular} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <SiteNavigation />
    <noscript><style>.menu-toggle { display: none; }</style></noscript>
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>
